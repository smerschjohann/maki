FROM ghcr.io/smerschjohann/keg:v0.1.0-runtime

RUN apt-get update \
 && apt-get install -y --no-install-recommends git bash ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY entrypoint.sh /usr/local/bin/ai-fix-entrypoint
RUN chmod +x /usr/local/bin/ai-fix-entrypoint

ENTRYPOINT ["/usr/local/bin/ai-fix-entrypoint"]
